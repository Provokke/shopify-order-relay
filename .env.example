# Copy to .env for local runs. Never commit real values.
# Client secret of the Shopify app that owns the webhook subscription (used for HMAC).
SHOPIFY_API_SECRET=replace-me
# Admin API access token for the shop (offline token from OAuth / custom app).
SHOPIFY_ADMIN_TOKEN=replace-me
SHOPIFY_SHOP_DOMAIN=example-dev-store.myshopify.com
SHOPIFY_API_VERSION=2026-10
# Downstream system receiving normalised order events.
DESTINATION_URL=https://erp.example.com/api/orders
DESTINATION_TOKEN=replace-me
# AWS resources (deployed mode only)
IDEMPOTENCY_TABLE=order-relay-idempotency
ORDER_QUEUE_URL=https://sqs.ap-southeast-2.amazonaws.com/000000000000/order-relay
