{
  "name": "shopify-order-relay",
  "version": "0.4.0",
  "description": "Webhook ingestion, idempotent processing and reliable delivery for Shopify orders",
  "license": "MIT",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "demo:local": "npm run build && node dist/demo/main.js",
    "demo:send": "npm run build && node dist/demo/scenario.js --url http://127.0.0.1:8787",
    "demo:scenario": "npm run build && node dist/demo/scenario.js",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/client-sqs": "^3.600.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/aws-lambda": "^8.10.140",
    "@types/node": "^20.14.0",
    "eslint": "^9.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Provokke/shopify-order-relay.git"
  },
  "author": "Provokke",
  "keywords": [
    "shopify",
    "webhooks",
    "orders",
    "relay",
    "idempotent",
    "sqs",
    "lambda"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/types.d.ts",
      "default": "./dist/src/lambda.js"
    },
    "./ingest": {
      "types": "./dist/src/ingest/handler.d.ts",
      "default": "./dist/src/ingest/handler.js"
    },
    "./worker": {
      "types": "./dist/src/worker/handler.d.ts",
      "default": "./dist/src/worker/handler.js"
    },
    "./hmac": {
      "types": "./dist/src/hmac.d.ts",
      "default": "./dist/src/hmac.js"
    },
    "./retry": {
      "types": "./dist/src/retry.d.ts",
      "default": "./dist/src/retry.js"
    }
  },
  "main": "./dist/src/lambda.js",
  "types": "./dist/src/types.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
